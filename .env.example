# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Notion internal integration token, connected to the database that holds
# the Project and Job data sources (database ••• menu -> Connections)
NOTION_API_KEY=
NOTION_PROJECT_DATA_SOURCE_ID=0d5275a3-dd53-82d7-8c5b-87a972cb1a47
NOTION_JOB_DATA_SOURCE_ID=f33275a3-dd53-8230-80d5-07caf490132b

# Optional: the company RECEIVING the POs, so Gemini never mistakes it for the customer
OWN_COMPANY_NAME=

# Optional: require this password (any username) to open the page
DEMO_PASSWORD=
